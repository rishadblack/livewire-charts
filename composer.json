{
    "name": "rishadblack/livewire-charts",
    "description": "Livewire Charts (fork of asantibanez/livewire-charts with Laravel 13 and Livewire 4 support)",
    "keywords": [
        "asantibanez",
        "livewire-charts",
        "rishadblack"
    ],
    "homepage": "https://github.com/rishadblack/livewire-charts",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Andrés Santibáñez",
            "email": "santibanez.andres@gmail.com",
            "role": "Developer"
        },
        {
            "name": "S M Rishad",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "replace": {
        "asantibanez/livewire-charts": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Asantibanez\\LivewireCharts\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asantibanez\\LivewireCharts\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asantibanez\\LivewireCharts\\LivewireChartsServiceProvider"
            ],
            "aliases": {
                "LivewireCharts": "Asantibanez\\LivewireCharts\\Facades\\LivewireCharts"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
